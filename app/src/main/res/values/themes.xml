<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; this exists only so the window has a dark background
         before the first frame, which stops the white flash on cold start. -->
    <style name="Theme.PrepTracker" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
