<?xml version="1.0" encoding="utf-8"?>
<!--
  Thick, rounded, gradient track. A stock ProgressBar with a tint reads as a hairline on a home
  screen; this is drawn to be legible at a glance from arm's length.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#23232C" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#4A9EFF"
                    android:centerColor="#7AC0FF"
                    android:endColor="#B39DFF" />
            </shape>
        </clip>
    </item>
</layer-list>
